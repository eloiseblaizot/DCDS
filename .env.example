# --- Supabase (bouton « Connect », ou Project Settings > Data API / API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clé publique « publishable » (ou « anon ») : lecture côté navigateur, protégée par la RLS
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# (l'ancien nom NEXT_PUBLIC_SUPABASE_ANON_KEY est aussi accepté)
# Clé secrète « service_role » / « secret » : serveur uniquement, ne jamais la préfixer NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# --- LiveKit Cloud (Settings > Keys) ---
LIVEKIT_URL=wss://xxxxxxxx.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
